# ===========================================
# Coffee Kat Backend - Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o arquivo .env no repositório.

# Porta do servidor backend
PORT=3001

# URL do frontend (para configuração do CORS)
FRONTEND_URL=http://localhost:5173

# Firebase Admin SDK
# Caminho para o arquivo JSON de credenciais do Service Account
# Baixe em: Firebase Console > Configurações do Projeto > Contas de Serviço > Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# Segurança - Chave para criptografia de sessão (gere uma string aleatória forte)
SESSION_SECRET=mude-esta-chave-para-algo-seguro-e-aleatorio

# Ambiente
NODE_ENV=development
