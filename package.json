{
  "name": "coffeekat-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Frontend da loja Coffee Kat - E-commerce de cafeteria",
  "scripts": {
    "dev": "vite",
    "dev:back": "node --watch backend/server.js",
    "dev:full": "concurrently -n FRONT,BACK -c cyan,yellow \"npm run dev\" \"npm run dev:back\"",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && firebase deploy --only hosting:coffeekat"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10"
  }
}
